<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_googletv"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp"
    android:elevation="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_notification"
                android:tint="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pusat Kontrol &amp; Notifikasi"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Semua sistem berjalan normal • Tidak ada peringatan"
            android:textColor="#8E95A5"
            android:textSize="11.5sp"
            android:fontFamily="@font/poppins" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1FFFFFFF"
        android:layout_marginBottom="12dp" />

    <!-- 1. Buka Pengaturan TV -->
    <TextView
        android:id="@+id/btn_cc_settings"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/selector_dialog_item_googletv"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:focusable="true"
        android:clickable="true"
        android:text="⚙️  Pengaturan Lengkap TV"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins" />

    <!-- 2. Jaringan Wi-Fi & Internet -->
    <TextView
        android:id="@+id/btn_cc_network"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/selector_dialog_item_googletv"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:focusable="true"
        android:clickable="true"
        android:text="📶  Jaringan &amp; Wi-Fi"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins" />

    <!-- 3. Sumber Input TV (HDMI/AV) -->
    <TextView
        android:id="@+id/btn_cc_inputs"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/selector_dialog_item_googletv"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:focusable="true"
        android:clickable="true"
        android:text="📺  Pilih Sumber Input (HDMI / AV)"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins" />

    <!-- 4. Mode Tidur (Screensaver) -->
    <TextView
        android:id="@+id/btn_cc_sleep"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/selector_dialog_item_googletv"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:focusable="true"
        android:clickable="true"
        android:text="🌙  Aktifkan Screensaver (Mode Tidur)"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins" />

    <!-- 5. Tutup -->
    <TextView
        android:id="@+id/btn_cc_close"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/selector_dialog_item_googletv"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:focusable="true"
        android:clickable="true"
        android:text="Tutup"
        android:textColor="#A0A5B5"
        android:textSize="12.5sp"
        android:fontFamily="@font/poppins" />

</LinearLayout>

