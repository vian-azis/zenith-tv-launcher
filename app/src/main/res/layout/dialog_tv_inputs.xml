<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_googletv"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp"
    android:elevation="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sumber Input TV"
            android:textColor="@color/selector_dialog_item_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Pilih port masukan atau saluran siaran"
            android:textColor="#8E95A5"
            android:textSize="11sp"
            android:fontFamily="@font/poppins" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1FFFFFFF"
        android:layout_marginBottom="10dp" />

    <!-- HDMI 1 -->
    <TextView
        android:id="@+id/btn_input_hdmi1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/selector_dialog_item_googletv"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:focusable="true"
        android:clickable="true"
        android:text="HDMI 1"
        android:textColor="@color/selector_dialog_item_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins" />

    <!-- HDMI 2 -->
    <TextView
        android:id="@+id/btn_input_hdmi2"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/selector_dialog_item_googletv"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:focusable="true"
        android:clickable="true"
        android:text="HDMI 2 (eARC)"
        android:textColor="@color/selector_dialog_item_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins" />

    <!-- Siaran TV / Live TV -->
    <TextView
        android:id="@+id/btn_input_livetv"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/selector_dialog_item_googletv"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:focusable="true"
        android:clickable="true"
        android:text="Siaran TV (Live TV)"
        android:textColor="@color/selector_dialog_item_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins" />

    <!-- AV / Komposit -->
    <TextView
        android:id="@+id/btn_input_av"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/selector_dialog_item_googletv"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:focusable="true"
        android:clickable="true"
        android:text="AV (Komposit)"
        android:textColor="@color/selector_dialog_item_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins" />

    <!-- Pengaturan Input TV -->
    <TextView
        android:id="@+id/btn_input_settings"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/selector_dialog_item_googletv"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:focusable="true"
        android:clickable="true"
        android:text="Pengaturan Input TV"
        android:textColor="@color/selector_dialog_item_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins" />

    <!-- Batal -->
    <TextView
        android:id="@+id/btn_input_cancel"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/selector_dialog_item_googletv"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:focusable="true"
        android:clickable="true"
        android:text="Batal"
        android:textColor="#A0A5B5"
        android:textSize="12.5sp"
        android:fontFamily="@font/poppins" />

</LinearLayout>

