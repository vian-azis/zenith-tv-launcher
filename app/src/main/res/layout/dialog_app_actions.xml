<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_app_actions_root"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_app_actions_glass"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="20dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp"
    android:elevation="24dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ==================== HEADER INFORMASI APLIKASI ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <!-- App Icon / Banner Frame (56x56dp, 14dp radius) -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_spatial_tile_idle">

            <ImageView
                android:id="@+id/dialog_app_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="App Icon" />
        </FrameLayout>

        <!-- App Text Metadata Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialog_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Aplikasi"
                android:textColor="#F8FAFC"
                android:textSize="17.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dialog_app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.0.0"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/dialog_app_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aplikasi Pengguna"
                    android:textColor="#38BDF8"
                    android:textSize="11.5sp"
                    android:fontFamily="@font/poppins_semibold" />
            </LinearLayout>

            <TextView
                android:id="@+id/dialog_app_package"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="com.example.app"
                android:textColor="#64748B"
                android:textSize="9.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/poppins" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hairline Specular Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#14FFFFFF"
        android:layout_marginBottom="12dp" />

    <!-- ==================== ACTION BUTTONS LIST (ANTI-CLIPPING CONTAINER) ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Action 1: Favorite Toggle (Pin/Unpin) - Primary Action on Long-Press -->
        <LinearLayout
            android:id="@+id/btn_action_fav"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/selector_dialog_action_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:focusedByDefault="true"
            android:clickable="true">
            <requestFocus />

            <ImageView
                android:id="@+id/icon_action_fav"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_star"
                android:tint="@color/selector_dialog_action_icon" />

            <TextView
                android:id="@+id/text_action_fav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:duplicateParentState="true"
                android:text="Sematkan ke Favorit"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14.5sp"
                android:fontFamily="@font/poppins_semibold" />

            <TextView
                android:id="@+id/sub_action_fav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:text="Akses cepat"
                android:textColor="@color/selector_dialog_action_subtext"
                android:textSize="11sp"
                android:fontFamily="@font/poppins" />
        </LinearLayout>

        <!-- Action 2: Move / Reorder (Supported for both Row 1 and Row 4) -->
        <LinearLayout
            android:id="@+id/btn_action_move"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/selector_dialog_action_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:id="@+id/icon_action_move"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_swap_horiz"
                android:tint="@color/selector_dialog_action_icon" />

            <TextView
                android:id="@+id/text_action_move"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:duplicateParentState="true"
                android:text="Pindahkan Posisi"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14.5sp"
                android:fontFamily="@font/poppins_semibold" />

            <TextView
                android:id="@+id/sub_action_move"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:text="Atur urutan"
                android:textColor="@color/selector_dialog_action_subtext"
                android:textSize="11sp"
                android:fontFamily="@font/poppins" />
        </LinearLayout>

        <!-- Action 3: App Info (Always available system detail shortcut) -->
        <LinearLayout
            android:id="@+id/btn_action_info"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/selector_dialog_action_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:id="@+id/icon_action_info"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_info_outline"
                android:tint="@color/selector_dialog_action_icon" />

            <TextView
                android:id="@+id/text_action_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:duplicateParentState="true"
                android:text="Info Aplikasi"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14.5sp"
                android:fontFamily="@font/poppins_semibold" />

            <TextView
                android:id="@+id/sub_action_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:text="Izin &amp; memori"
                android:textColor="@color/selector_dialog_action_subtext"
                android:textSize="11sp"
                android:fontFamily="@font/poppins" />
        </LinearLayout>

        <!-- Action 4: Uninstall / Uninstall Updates (Destructive Styling) -->
        <LinearLayout
            android:id="@+id/btn_action_uninstall"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/selector_dialog_action_destructive_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:id="@+id/icon_action_uninstall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_delete"
                android:tint="@color/selector_dialog_action_danger_icon" />

            <TextView
                android:id="@+id/text_action_uninstall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:duplicateParentState="true"
                android:text="Copot Pemasangan"
                android:textColor="@color/selector_dialog_item_danger_text"
                android:textSize="14.5sp"
                android:fontFamily="@font/poppins_semibold" />

            <TextView
                android:id="@+id/sub_action_uninstall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:text="Hapus dari TV"
                android:textColor="@color/selector_dialog_action_danger_subtext"
                android:textSize="11sp"
                android:fontFamily="@font/poppins" />
        </LinearLayout>

        <!-- Action 5: Open App (Secondary action on long press) -->
        <LinearLayout
            android:id="@+id/btn_action_open"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/selector_dialog_action_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:id="@+id/icon_action_open"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_play_arrow"
                android:tint="@color/selector_dialog_action_icon" />

            <TextView
                android:id="@+id/text_action_open"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:duplicateParentState="true"
                android:text="Buka Aplikasi"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14.5sp"
                android:fontFamily="@font/poppins_semibold" />

            <TextView
                android:id="@+id/sub_action_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:text="Luncurkan"
                android:textColor="@color/selector_dialog_action_subtext"
                android:textSize="11sp"
                android:fontFamily="@font/poppins" />
        </LinearLayout>

        <!-- Action 6: Cancel -->
        <LinearLayout
            android:id="@+id/btn_action_cancel"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/selector_dialog_action_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:id="@+id/icon_action_cancel"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_close"
                android:tint="@color/selector_dialog_action_icon" />

            <TextView
                android:id="@+id/text_action_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:duplicateParentState="true"
                android:text="Batal"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14sp"
                android:fontFamily="@font/poppins" />

            <TextView
                android:id="@+id/sub_action_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:text="Tutup menu"
                android:textColor="@color/selector_dialog_action_subtext"
                android:textSize="11sp"
                android:fontFamily="@font/poppins" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
